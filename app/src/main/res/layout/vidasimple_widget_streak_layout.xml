<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_streak_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_background"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Streak Flame & Count -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingRight="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="20sp"
                android:layout_marginRight="4dp" />

            <TextView
                android:id="@+id/widget_streak_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 días"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#1AFFFFFF"
            android:layout_marginRight="10dp" />

        <!-- Motivation Quote -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOTIVACIÓN"
                android:textColor="#FFC837"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/widget_motivation_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="La constancia es la clave."
                android:textColor="#E5E5EA"
                android:textSize="10sp"
                android:ellipsize="end"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
