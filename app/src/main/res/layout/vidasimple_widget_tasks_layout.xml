<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/widget_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/widget_background"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mis Tareas"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tasks_header_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 pendientes"
                android:textColor="#8A8A8F"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/widget_tasks_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 ¡Todo al día!"
                android:textColor="#30D158"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tasks List Container -->
        <LinearLayout
            android:id="@+id/widget_tasks_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical">

            <!-- Task Row 1 -->
            <LinearLayout
                android:id="@+id/widget_task_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_task_dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#8A8A8F"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/widget_task_text_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tarea de ejemplo"
                    android:textColor="#E5E5EA"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Task Row 2 -->
            <LinearLayout
                android:id="@+id/widget_task_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_task_dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#8A8A8F"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/widget_task_text_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Otra tarea"
                    android:textColor="#E5E5EA"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Task Row 3 -->
            <LinearLayout
                android:id="@+id/widget_task_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_task_dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="#8A8A8F"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/widget_task_text_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Y una más"
                    android:textColor="#E5E5EA"
                    android:textSize="11sp"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1AFFFFFF"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <!-- Button -->
        <TextView
            android:id="@+id/widget_btn_tasks_add_direct"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:text="+ Nueva Tarea"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_button_background"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</FrameLayout>
